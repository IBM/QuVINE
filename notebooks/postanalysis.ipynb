    "    \n",
    "    if len(task_data) > 0:\n",
    "        ax.hist(task_data, bins=30, color='#E67E22', alpha=0.7, edgecolor='black')\n",
    "        ax.axvline(0, color='red', linestyle='--', linewidth=2, label='No difference')\n",
    "        ax.axvline(task_data.mean(), color='blue', linestyle='-', linewidth=2, \n",
    "                  label=f'Mean: {task_data.mean():.1f}%')\n",
    "        \n",
    "        ax.set_xlabel('Percent Improvement (Mean)', fontsize=11, fontweight='bold')\n",
