    "delta_results = []\n",
    "\n",
    "if 'base_dataset' in df_filtered.columns:\n",
    "    for base_ds in base_datasets:\n",
    "        df_ds = df_filtered[df_filtered['base_dataset'] == base_ds]\n",
    "        \n",
    "        # Calculate complexity statistics across all reps for this base dataset\n",
    "        complexity_stats = {}\n",
    "        for col in complexity_cols:\n",
    "            if col in df_ds.columns:\n",
    "                values = df_ds[col].dropna()\n",
    "                if len(values) > 0:\n",
    "                    complexity_stats[f'{col}_mean'] = values.mean()\n",
    "                    complexity_stats[f'{col}_median'] = values.median()\n",
    "                    complexity_stats[f'{col}_std'] = values.std()\n",
    "        \n",
    "        for task_name, metric in task_metrics.items():\n",
    "            if metric in df_ds.columns and not df_ds[metric].isna().all():\n",
    "                # Find best quantum method by mean\n",
    "                quantum_df = df_ds[df_ds['method_type'] == 'Quantum']\n",
    "                quantum_means = quantum_df.groupby('method')[metric].mean()\n",
    "                if len(quantum_means) > 0:\n",
    "                    best_quantum_method = quantum_means.idxmax()\n",
    "                    quantum_values = quantum_df[quantum_df['method'] == best_quantum_method][metric].dropna()\n",
    "                else:\n",
    "                    continue\n",
    "                \n",
    "                # Find best classical method by mean\n",
    "                classical_df = df_ds[df_ds['method_type'] == 'Classical']\n",
    "                classical_means = classical_df.groupby('method')[metric].mean()\n",
    "                if len(classical_means) > 0:\n",
    "                    best_classical_method = classical_means.idxmax()\n",
    "                    classical_values = classical_df[classical_df['method'] == best_classical_method][metric].dropna()\n",
    "                else:\n",
    "                    continue\n",
    "                \n",
    "                if len(quantum_values) > 0 and len(classical_values) > 0:\n",
    "                    # Calculate statistics for quantum\n",
    "                    quantum_median = quantum_values.median()\n",
    "                    quantum_mean = quantum_values.mean()\n",
    "                    quantum_std = quantum_values.std()\n",
    "                    \n",
    "                    # Calculate statistics for classical\n",
    "                    classical_median = classical_values.median()\n",
    "                    classical_mean = classical_values.mean()\n",
    "                    classical_std = classical_values.std()\n",
    "                    \n",
    "                    # Calculate deltas\n",
    "                    delta_median = quantum_median - classical_median\n",
    "                    delta_mean = quantum_mean - classical_mean\n",
    "                    \n",
    "                    # Calculate percent improvements\n",
    "                    percent_improvement_median = (delta_median / classical_median * 100) if classical_median != 0 else 0\n",
    "                    percent_improvement_mean = (delta_mean / classical_mean * 100) if classical_mean != 0 else 0\n",
    "                    \n",
    "                    # Statistical test\n",
    "                    statistic, p_value = ranksums(quantum_values, classical_values)\n",
    "                    sig_stars = get_significance_stars(p_value)\n",
    "                    \n",
    "                    # Combine all data\n",
    "                    result_dict = {\n",
    "                        'base_dataset': base_ds,\n",
    "                        'task': task_name,\n",
    "                        'best_quantum_method': best_quantum_method,\n",
    "                        'best_classical_method': best_classical_method,\n",
    "                        'quantum_median': quantum_median,\n",
    "                        'quantum_mean': quantum_mean,\n",
    "                        'quantum_std': quantum_std,\n",
    "                        'classical_median': classical_median,\n",
    "                        'classical_mean': classical_mean,\n",
    "                        'classical_std': classical_std,\n",
    "                        'delta_median': delta_median,\n",
    "                        'delta_mean': delta_mean,\n",
    "                        'percent_improvement_median': percent_improvement_median,\n",
    "                        'percent_improvement_mean': percent_improvement_mean,\n",
    "                        'p_value': p_value,\n",
    "                        'significance': sig_stars,\n",
    "                        'n_quantum_reps': len(quantum_values),\n",
    "                        'n_classical_reps': len(classical_values)\n",
    "                    }\n",
    "                    \n",
    "                    # Add complexity statistics\n",
    "                    result_dict.update(complexity_stats)\n",
    "                    \n",
    "                    delta_results.append(result_dict)\n",
    "\n",
    "# Create delta dataframe\n",
    "delta_df = pd.DataFrame(delta_results)\n",
    "\n",
    "# Save comprehensive delta analysis\n",
    "delta_df.to_csv(meta_output_dir / 'delta_analysis_best_methods_with_complexity.csv', index=False)\n",
    "print(f\"\\n✓ Delta analysis (best methods + complexity) saved: {len(delta_df)} comparisons\")\n",
    "print(f\"  Total columns: {len(delta_df.columns)}\")\n",
    "print(f\"  Performance columns: 18\")\n",
    "print(f\"  Complexity columns: {len(delta_df.columns) - 18}\")\n",
    "\n",
    "# Display summary statistics\n",
    "print(\"\\n=== DELTA ANALYSIS SUMMARY (Best Methods Only) ===\")\n",
    "print(f\"\\nOverall statistics across all datasets:\")\n",
    "for task in ['Ranking', 'Classification', 'Link Prediction']:\n",
    "    task_deltas = delta_df[delta_df['task'] == task]\n",
    "    if len(task_deltas) > 0:\n",
    "        print(f\"\\n{task}:\")\n",
    "        print(f\"  Median-based improvement:\")\n",
    "        print(f\"    Mean: {task_deltas['percent_improvement_median'].mean():.2f}%\")\n",
    "        print(f\"    Median: {task_deltas['percent_improvement_median'].median():.2f}%\")\n",
    "        print(f\"    Std: {task_deltas['percent_improvement_median'].std():.2f}%\")\n",
    "        print(f\"  Mean-based improvement:\")\n",
    "        print(f\"    Mean: {task_deltas['percent_improvement_mean'].mean():.2f}%\")\n",
    "        print(f\"    Median: {task_deltas['percent_improvement_mean'].median():.2f}%\")\n",
    "        print(f\"    Std: {task_deltas['percent_improvement_mean'].std():.2f}%\")\n",
    "        print(f\"  Statistical significance:\")\n",
    "        print(f\"    Significant (p<0.05): {(task_deltas['p_value'] < 0.05).sum()}/{len(task_deltas)}\")\n",
    "        print(f\"    Highly significant (p<0.001): {(task_deltas['p_value'] < 0.001).sum()}/{len(task_deltas)}\")\n",
    "        print(f\"  Datasets where quantum wins (median): {(task_deltas['delta_median'] > 0).sum()}/{len(task_deltas)}\")\n",
    "        print(f\"  Datasets where quantum wins (mean): {(task_deltas['delta_mean'] > 0).sum()}/{len(task_deltas)}\")\n",
    "        \n",
    "        # Show most common best methods\n",
    "        print(f\"  Most common quantum methods:\")\n",
    "        print(task_deltas['best_quantum_method'].value_counts().head(3).to_string())\n",
    "        print(f\"  Most common classical methods:\")\n",
    "        print(task_deltas['best_classical_method'].value_counts().head(3).to_string())"
   ]
