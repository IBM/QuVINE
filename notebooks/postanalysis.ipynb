    "    task_data = delta_df[delta_df['task'] == task]['percent_improvement_median']\n",
    "    \n",
    "    if len(task_data) > 0:\n",
    "        ax.hist(task_data, bins=30, color='#9B59B6', alpha=0.7, edgecolor='black')\n",
    "        ax.axvline(0, color='red', linestyle='--', linewidth=2, label='No difference')\n",
    "        ax.axvline(task_data.median(), color='green', linestyle='-', linewidth=2, \n",
    "                  label=f'Median: {task_data.median():.1f}%')\n",
    "        \n",
    "        ax.set_xlabel('Percent Improvement (Median)', fontsize=11, fontweight='bold')\n",
    "        ax.set_ylabel('Number of Datasets', fontsize=11, fontweight='bold')\n",
    "        ax.set_title(f'{task} (Median-based)', fontsize=13, fontweight='bold')\n",
    "        ax.legend()\n",
    "        ax.grid(True, alpha=0.3)\n",
    "\n",
    "# Row 2: Mean-based\n",
    "for idx, task in enumerate(['Ranking', 'Classification', 'Link Prediction']):\n",
    "    ax = axes[1, idx]\n",
