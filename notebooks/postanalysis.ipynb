    "# Create output directory\n",
    "meta_output_dir = Path(PATH) / 'meta_analysis'\n",
    "meta_output_dir.mkdir(exist_ok=True)\n",
    "\n",
    "task_metrics = {\n",
    "    'Ranking': 'ranking_precision@10_centroid',\n",
    "    'Classification': 'classification_mean_f1_macro',\n",
    "    'Link Prediction': 'link_prediction_mean_auc_roc'\n",
    "}\n",
    "\n",
    "def get_significance_stars(p_value):\n",
    "    \"\"\"Convert p-value to significance stars\"\"\"\n",
    "    if p_value < 0.001:\n",
    "        return '***'\n",
    "    elif p_value < 0.01:\n",
    "        return '**'\n",
    "    elif p_value < 0.05:\n",
    "        return '*'\n",
    "    else:\n",
    "        return 'ns'\n",
    "\n",
    "if 'base_dataset' in df_filtered.columns:\n",
    "    base_datasets = sorted(df_filtered['base_dataset'].unique())\n",
    "    print(f\"Creating {len(base_datasets)} plots with best methods only...\")\n",
    "    \n",
    "    for base_ds in base_datasets:\n",
    "        df_ds = df_filtered[df_filtered['base_dataset'] == base_ds]\n",
    "        if len(df_ds) == 0:\n",
    "            continue\n",
    "        \n",
    "        fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n",
    "        \n",
    "        for idx, (task_name, metric) in enumerate(task_metrics.items()):\n",
    "            ax = axes[idx]\n",
    "            \n",
    "            if metric in df_ds.columns and not df_ds[metric].isna().all():\n",
    "                # Find best quantum method by mean performance\n",
    "                quantum_df = df_ds[df_ds['method_type'] == 'Quantum']\n",
    "                quantum_means = quantum_df.groupby('method')[metric].mean()\n",
    "                if len(quantum_means) > 0:\n",
    "                    best_quantum_method = quantum_means.idxmax()\n",
    "                    quantum_data = quantum_df[quantum_df['method'] == best_quantum_method][metric].dropna()\n",
    "                else:\n",
    "                    quantum_data = pd.Series(dtype=float)\n",
    "                    best_quantum_method = 'N/A'\n",
    "                \n",
    "                # Find best classical method by mean performance\n",
    "                classical_df = df_ds[df_ds['method_type'] == 'Classical']\n",
    "                classical_means = classical_df.groupby('method')[metric].mean()\n",
    "                if len(classical_means) > 0:\n",
    "                    best_classical_method = classical_means.idxmax()\n",
    "                    classical_data = classical_df[classical_df['method'] == best_classical_method][metric].dropna()\n",
    "                else:\n",
    "                    classical_data = pd.Series(dtype=float)\n",
    "                    best_classical_method = 'N/A'\n",
    "                \n",
    "                if len(quantum_data) > 0 and len(classical_data) > 0:\n",
    "                    # Create boxplot\n",
    "                    bp = ax.boxplot(\n",
    "                        [quantum_data, classical_data],\n",
    "                        tick_labels=['Quantum', 'Classical'],\n",
    "                        patch_artist=True,\n",
    "                        widths=0.6\n",
    "                    )\n",
    "                    \n",
    "                    bp['boxes'][0].set_facecolor(QUANTUM_COLOR)\n",
    "                    bp['boxes'][0].set_alpha(0.7)\n",
    "                    bp['boxes'][1].set_facecolor(CLASSICAL_COLOR)\n",
    "                    bp['boxes'][1].set_alpha(0.7)\n",
    "                    \n",
    "                    # Perform Wilcoxon rank-sum test\n",
    "                    statistic, p_value = ranksums(quantum_data, classical_data)\n",
    "                    sig_stars = get_significance_stars(p_value)\n",
    "                    \n",
    "                    # Add significance annotation\n",
    "                    y_max = max(quantum_data.max(), classical_data.max())\n",
    "                    y_min = min(quantum_data.min(), classical_data.min())\n",
    "                    y_range = y_max - y_min\n",
    "                    \n",
    "                    # Draw significance bar\n",
    "                    bar_height = y_max + 0.05 * y_range\n",
    "                    ax.plot([1, 2], [bar_height, bar_height], 'k-', linewidth=1.5)\n",
    "                    ax.text(1.5, bar_height + 0.02 * y_range, sig_stars, \n",
    "                           ha='center', va='bottom', fontsize=14, fontweight='bold')\n",
    "                    \n",
    "                    ax.set_title(task_name, fontsize=13, fontweight='bold')\n",
    "                    ax.set_ylabel('Score', fontsize=12, fontweight='bold')\n",
    "                    ax.yaxis.grid(True, linestyle='--', alpha=0.3)\n",
    "                    \n",
    "                    # Add method names below x-axis - FIXED POSITIONING\n",
    "                    # Get current y-axis limits\n",
    "                    ylim = ax.get_ylim()\n",
    "                    y_pos = ylim[0] - 0.12 * (ylim[1] - ylim[0])  # Position below axis\n",
    "                    \n",
    "                    ax.text(1, y_pos, f'({best_quantum_method})', \n",
    "                           ha='center', va='top', fontsize=8, style='italic',\n",
    "                           clip_on=False)\n",
    "                    ax.text(2, y_pos, f'({best_classical_method})', \n",
    "                           ha='center', va='top', fontsize=8, style='italic',\n",
    "                           clip_on=False)\n",
    "                    \n",
    "                    # Add p-value\n",
    "                    ax.text(0.02, 0.98, f'p={p_value:.4f}', \n",
    "                           transform=ax.transAxes, fontsize=9,\n",
    "                           verticalalignment='top', bbox=dict(boxstyle='round', \n",
    "                           facecolor='wheat', alpha=0.5))\n",
