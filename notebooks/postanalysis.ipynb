   "source": [
    "## Analysis: Missing Columns in PPI Dataset\n",
    "\n",
    "The PPI dataset has 136 columns while hn4 and hg both have 149 columns (difference of 13).\n",
    "\n",
    "**Key Finding:** PPI uses abbreviated column names (clf_, lp_) while hn4/hg use full names (classification_, link_prediction_).\n",
    "Most columns have equivalents, but 14 columns are truly missing in PPI with no abbreviated equivalent."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "find_missing_cols",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the three datasets with correct filenames\n",
    "hn4_df = pd.read_csv('../../results/comprehensive_results_hn4.csv')\n",
    "hg_df = pd.read_csv('../../results/comprehensive_results_hg.csv')\n",
    "ppi_df = pd.read_csv('../../results/comprehensive_results_all_ppi.csv')\n",
    "\n",
    "print('=== Column Counts ===')\n",
    "print(f'hn4: {len(hn4_df.columns)} columns')\n",
    "print(f'hg: {len(hg_df.columns)} columns')\n",
    "print(f'ppi: {len(ppi_df.columns)} columns')\n",
    "print(f'Difference: {len(hn4_df.columns) - len(ppi_df.columns)} columns')\n",
    "\n",
    "# Find all columns in hn4/hg but not in ppi (with full names)\n",
    "missing_full = set(hn4_df.columns) - set(ppi_df.columns)\n",
    "# Find all columns in ppi but not in hn4/hg (abbreviated names)\n",
    "unique_abbrev = set(ppi_df.columns) - set(hn4_df.columns)\n",
    "\n",
    "print(f'\\nColumns in hn4/hg with full names not in ppi: {len(missing_full)}')\n",
    "print(f'Columns in ppi with abbreviated names not in hn4/hg: {len(unique_abbrev)}')\n",
    "print(f'Net difference: {len(missing_full) - len(unique_abbrev)} (matches {len(hn4_df.columns) - len(ppi_df.columns)})')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "find_truly_missing",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Map abbreviated names to full names\n",
    "missing_full = sorted(set(hn4_df.columns) - set(ppi_df.columns))\n",
    "unique_abbrev = sorted(set(ppi_df.columns) - set(hn4_df.columns))\n",
    "\n",
    "mapping = {}\n",
    "for abbrev in unique_abbrev:\n",
    "    for full in missing_full:\n",
    "        abbrev_parts = abbrev.replace('clf_', '').replace('lp_', '')\n",
    "        full_parts = full.replace('classification_', '').replace('link_prediction_', '')\n",
    "        \n",
    "        # Handle special naming differences\n",
    "        if abbrev == 'clf_n_strategies' and full == 'classification_n_successful_strategies':\n",
    "            mapping[full] = abbrev\n",
    "        elif abbrev == 'lp_n_methods' and full == 'link_prediction_n_successful_methods':\n",
    "            mapping[full] = abbrev\n",
    "        elif abbrev == 'lp_mean_f1' and full == 'link_prediction_f1_average':\n",
    "            mapping[full] = abbrev\n",
    "        elif abbrev_parts == full_parts:\n",
    "            mapping[full] = abbrev\n",
    "\n",
    "# Find columns with no equivalent\n",
    "truly_missing = [col for col in missing_full if col not in mapping]\n",
    "\n",
    "print(f'=== THE {len(truly_missing)} COLUMNS TRULY MISSING IN PPI ===')\n",
    "print('(These have no abbreviated equivalent in the PPI dataset)\\n')\n",
    "for col in truly_missing:\n",
    "    print(f'  - {col}')\n",
    "\n",
    "print(f'\\n=== Summary ===')\n",
    "print(f'Classification accuracy metrics (per strategy): 7 columns')\n",
    "print(f'Classification min/max stats: 3 columns')\n",
    "print(f'Link prediction min stats: 2 columns')\n",
    "print(f'Link prediction metadata: 2 columns (negative_strategy, std_mrr)')"
   ]
