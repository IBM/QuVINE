  {
   "cell_type": "markdown",
   "id": "method_classification",
   "metadata": {},
   "source": [
    "### 8.1 Method Classification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "classify_methods",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define quantum and classical methods (excluding BL-filter)\n",
    "quantum_methods = ['quvine_heat', 'quvine_fused-filt', 'quvine_rwr', 'quvine_ctqw', \n",
    "                   'quvine_poly', 'quvine_fused', 'quvine_hgcnmf']\n",
    "classical_methods = ['node2vec', 'netmf', 'gcn', 'graphsage', 'appnp']\n",
    "\n",
    "# Filter out BL-filter if present\n",
    "if 'method' in compiled_df.columns:\n",
    "    all_methods = compiled_df['method'].unique()\n",
    "    print(f\"All methods found: {sorted(all_methods)}\")\n",
    "    \n",
    "    # Identify which methods are actually present\n",
    "    present_quantum = [m for m in quantum_methods if m in all_methods]\n",
    "    present_classical = [m for m in classical_methods if m in all_methods]\n",
    "    \n",
    "    print(f\"\\nQuantum methods present: {present_quantum}\")\n",
    "    print(f\"Classical methods present: {present_classical}\")\n",
    "    \n",
    "    # Create filtered dataframe\n",
    "    df_filtered = compiled_df[compiled_df['method'].isin(present_quantum + present_classical)].copy()\n",
    "    df_filtered['method_type'] = df_filtered['method'].apply(\n",
    "        lambda x: 'Quantum' if x in quantum_methods else 'Classical'\n",
    "    )\n",
    "    \n",
    "    print(f\"\\nFiltered dataframe shape: {df_filtered.shape}\")\n",
    "    print(f\"Method type distribution:\\n{df_filtered['method_type'].value_counts()}\")\n",
    "else:\n",
    "    print(\"Warning: 'method' column not found in compiled dataframe\")\n",
    "    df_filtered = compiled_df.copy()"
   ]
