  {
   "cell_type": "markdown",
   "id": "delta_analysis",
   "metadata": {},
   "source": [
    "### 8.3 Performance Delta Analysis\n",
    "\n",
    "Calculating the performance difference between quantum and classical methods for each dataset and task."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "calculate_deltas",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate mean performance for quantum vs classical by dataset and task\n",
    "delta_results = []\n",
    "\n",
    "# Define all metrics to analyze\n",
    "all_metrics = {\n",
    "    'Node Ranking': available_ranking if 'available_ranking' in locals() else [],\n",
    "    'Node Classification': available_class if 'available_class' in locals() else [],\n",
    "    'Link Prediction': available_link if 'available_link' in locals() else []\n",
    "}\n",
    "\n",
    "for task_name, metrics in all_metrics.items():\n",
    "    for metric in metrics:\n",
    "        for dataset in ['hn4', 'ppi', 'hg']:\n",
    "            df_subset = df_filtered[df_filtered['dataset'] == dataset]\n",
    "            \n",
    "            if len(df_subset) > 0 and not df_subset[metric].isna().all():\n",
    "                quantum_mean = df_subset[df_subset['method_type'] == 'Quantum'][metric].mean()\n",
    "                classical_mean = df_subset[df_subset['method_type'] == 'Classical'][metric].mean()\n",
    "                \n",
    "                if pd.notna(quantum_mean) and pd.notna(classical_mean):\n",
    "                    delta = quantum_mean - classical_mean\n",
    "                    delta_pct = (delta / classical_mean * 100) if classical_mean != 0 else 0\n",
    "                    \n",
    "                    delta_results.append({\n",
    "                        'Task': task_name,\n",
    "                        'Metric': metric.replace('_', ' ').title(),\n",
    "                        'Dataset': dataset.upper(),\n",
    "                        'Quantum Mean': quantum_mean,\n",
    "                        'Classical Mean': classical_mean,\n",
    "                        'Delta': delta,\n",
    "                        'Delta %': delta_pct\n",
    "                    })\n",
    "\n",
    "# Create delta dataframe\n",
    "delta_df = pd.DataFrame(delta_results)\n",
    "\n",
    "if len(delta_df) > 0:\n",
    "    print(\"Performance Delta Summary:\")\n",
    "    print(\"=\"*100)\n",
    "    print(delta_df.to_string(index=False))\n",
    "    \n",
    "    # Save to CSV\n",
    "    delta_df.to_csv(meta_output_dir / 'performance_delta_quantum_vs_classical.csv', index=False)\n",
    "    print(f\"\\n✓ Saved delta analysis to: {meta_output_dir / 'performance_delta_quantum_vs_classical.csv'}\")\n",
    "else:\n",
    "    print(\"No delta results calculated\")"
