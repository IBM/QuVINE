 "cells": [
  {
   "cell_type": "markdown",
   "id": "header",
   "metadata": {},
   "source": [
    "# Post-Analysis: Compiled Results Across All Datasets\n",
    "\n",
    "This notebook compiles and analyzes results from three different network datasets:\n",
    "- **HN4**: Random geometric networks\n",
    "- **PPI**: Protein-protein interaction networks (BioPlex3)\n",
    "- **HG**: HuggingFace graph datasets (Twitch egos)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "imports",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "from glob import glob\n",
    "\n",
    "# Set plotting style\n",
    "sns.set_style('whitegrid')\n",
    "plt.rcParams['figure.figsize'] = (12, 6)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "load_data",
   "metadata": {},
   "source": [
    "## 1. Load Datasets"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "load",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Set path to results directory\n",
    "PATH = '../../results/'\n",
    "\n",
    "# Define dataset identifiers\n",
    "dg = ['hn4', 'ppi', 'hg']\n",
    "\n",
    "# Load all datasets\n",
    "res_dict = {}\n",
    "for f in glob(PATH + '*.csv'):\n",
    "    for d in dg: \n",
    "        if d in f: \n",
    "            res_dict[d] = pd.read_csv(f)\n",
    "            print(f\"Loaded {d.upper()}: {res_dict[d].shape}\")\n",
    "\n",
    "print(f\"\\nTotal datasets loaded: {len(res_dict)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "column_analysis",
   "metadata": {},
   "source": [
    "## 2. Column Analysis\n",
    "\n",
    "Analyzing the structure and overlap of columns across datasets."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "columns",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check columns across datasets\n",
    "cols = []\n",
    "for k, v in res_dict.items():\n",
    "    print(f\"\\n{k.upper()} columns: {len(v.columns)}\")\n",
    "    cols.append(set(v.columns))\n",
    "\n",
    "# Find common columns\n",
    "common_cols = set.intersection(*cols)\n",
    "print(f\"\\nCommon columns across all datasets: {len(common_cols)}\")\n",
    "\n",
    "# Find all unique columns\n",
    "all_cols = set.union(*cols)\n",
    "print(f\"Total unique columns: {len(all_cols)}\")\n",
    "\n",
    "# Check for dataset-specific columns\n",
    "for dataset_name, dataset_cols in zip(res_dict.keys(), cols):\n",
    "    unique_to_dataset = dataset_cols - common_cols\n",
    "    if unique_to_dataset:\n",
    "        print(f\"\\nColumns unique to {dataset_name.upper()}: {len(unique_to_dataset)}\")\n",
    "        print(f\"  Examples: {list(unique_to_dataset)[:5]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "compile_section",
   "metadata": {},
   "source": [
    "## 3. Create Compiled Dataframe\n",
    "\n",
    "Combining all three datasets into a single unified dataframe with a 'dataset' identifier column."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "compile",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Add dataset identifier and compile\n",
    "compiled_dfs = []\n",
    "for dataset_name, df in res_dict.items():\n",
    "    df_copy = df.copy()\n",
    "    df_copy['dataset'] = dataset_name\n",
    "    compiled_dfs.append(df_copy)\n",
    "\n",
    "# Concatenate all datasets\n",
    "compiled_df = pd.concat(compiled_dfs, axis=0, ignore_index=True, sort=False)\n",
    "\n",
    "print(f\"Compiled dataframe shape: {compiled_df.shape}\")\n",
    "print(f\"\\nDatasets distribution:\")\n",
    "print(compiled_df['dataset'].value_counts())\n",
    "\n",
    "# Save compiled dataframe\n",
    "output_path = PATH + 'compiled_all_datasets.csv'\n",
    "compiled_df.to_csv(output_path, index=False)\n",
    "print(f\"\\n✓ Saved compiled dataframe to: {output_path}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "summary_section",
   "metadata": {},
   "source": [
    "## 4. Dataset Summary Statistics\n",
    "\n",
    "### 4.1 Network Properties by Dataset"
