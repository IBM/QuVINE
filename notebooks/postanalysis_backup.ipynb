    "network_props = ['num_nodes', 'num_edges', 'clustering_mean', 'modularity', 'spectral_gap']\n",
    "\n",
    "summary_stats = compiled_df.groupby('dataset')[network_props].agg(['mean', 'std', 'min', 'max'])\n",
    "print(\"Network Properties Summary by Dataset:\")\n",
    "print(\"=\"*80)\n",
    "print(summary_stats.round(4))"
   ]
