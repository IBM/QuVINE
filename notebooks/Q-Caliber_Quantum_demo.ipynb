    "        best_params = {\n",
    "            'hidden_dim': 32,\n",
    "            'n_layers': 2,\n",
    "            'mf_dim': 16,\n",
    "            'dropout': 0.5,\n",
    "            'lr': 0.01,\n",
    "            'weight_decay': 5e-4\n",
    "        }\n",
