    "# Initialize with default parameters (will be overwritten if tuning runs)\n",
    "best_params = {\n",
    "    'hidden_dim': 32,\n",
    "    'n_layers': 2,\n",
    "    'mf_dim': 16,\n",
    "    'dropout': 0.5,\n",
